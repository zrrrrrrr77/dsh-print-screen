{
  "name": "dsh-print-screen",
  "version": "0.4.5",
  "description": "Freezes the whole desktop from a scissors button in the DSH composer, crops a dragged region, and inserts it into the prompt as an image attachment. The shot is stored once in the DSH attachment library, indexed per session. Windows only.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "helper.ps1",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots.json",
    "scissors-button.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "screenshot",
    "snip",
    "composer",
    "windows"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "os": [
    "win32"
  ],
  "license": "MIT",
  "author": "zrrrrrrr77",
  "homepage": "https://github.com/zrrrrrrr77/dsh-print-screen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zrrrrrrr77/dsh-print-screen.git"
  },
  "bugs": {
    "url": "https://github.com/zrrrrrrr77/dsh-print-screen/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
